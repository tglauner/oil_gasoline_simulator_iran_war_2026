[Unit]
Description=Oil Gasoline Simulator Iran War 2026 FastAPI service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/oil_gasoline_simulator_iran_war_2026/backend
EnvironmentFile=/var/www/html/oil_gasoline_simulator_iran_war_2026/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/html/oil_gasoline_simulator_iran_war_2026/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8003 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/html/oil_gasoline_simulator_iran_war_2026/backend/logs
UMask=027
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
